{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.zero/schemas/zero-review/ed25519-keyring-v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "zero-review.ed25519-keyring.v2"},
    "keys": {"type": "object", "minProperties": 1, "additionalProperties": {
      "type": "object", "additionalProperties": false,
      "required": ["public_key", "roles", "not_before", "not_after", "revoked"],
      "properties": {
        "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["apex_producer", "override_approver", "ledger_checkpoint"]}},
        "not_before": {"type": "string", "format": "date-time"}, "not_after": {"type": "string", "format": "date-time"}, "revoked": {"type": "boolean"}
      }
    }}
  }
}
