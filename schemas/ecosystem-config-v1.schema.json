{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-review.local/schemas/ecosystem-config-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roots"],
  "properties": {
    "schema_version": { "const": "zero-review.ecosystem-config.v1" },
    "roots": { "type": "array", "items": { "type": "object" } },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent", "prefixes"],
        "properties": {
          "parent": { "type": "string", "minLength": 1 },
          "prefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exclude_name_contains": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "max_candidates": { "type": "integer", "minimum": 1, "maximum": 4096 }
        }
      }
    }
  }
}
