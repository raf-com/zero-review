{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.zero/schemas/zero-review/review-override-v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "repository", "pull_request_number", "base_sha", "head_sha", "tool_release_digest", "nonce", "requested_by", "approved_by", "reason", "evidence", "issued_at", "expires_at", "signer_key_id", "signature_algorithm", "signature"],
  "properties": {
    "schema_version": {"const": "zero-review.override.v2"},
    "repository": {"type": "string", "minLength": 1},
    "pull_request_number": {"type": "integer", "minimum": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "tool_release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "requested_by": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "review-packet-v2.schema.json#/$defs/evidence"}},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "signer_key_id": {"type": "string", "minLength": 1}, "signature_algorithm": {"const": "ed25519"}, "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
  }
}
