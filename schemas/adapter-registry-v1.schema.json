{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zero-review.local/schemas/adapter-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapters"],
  "properties": {
    "schema_version": { "const": "zero-review.adapter-registry.v1" },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "executable", "sha256", "working_directory", "timeout_ms", "output_limit_bytes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "executable": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "allowed_arguments": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "working_directory": { "type": "string", "minLength": 1 },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 900000 },
          "output_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
        }
      }
    }
  }
}
