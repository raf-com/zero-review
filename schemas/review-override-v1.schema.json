{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.zero/schemas/zero-review/review-override-v1.schema.json",
  "title": "Zero Review override v1",
  "type": "object",
  "required": ["schema_version", "repository", "pull_request_number", "head_sha", "requested_by", "approved_by", "reason", "evidence", "issued_at", "expires_at"],
  "properties": {
    "schema_version": { "const": "zero-review.override.v1" },
    "repository": { "type": "string", "minLength": 1 },
    "pull_request_number": { "type": "integer", "minimum": 1 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "requested_by": { "type": "string", "minLength": 1 },
    "approved_by": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "location", "sha256"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
